<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 权限 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission
            android:name="android.permission.PROVIDE_TRUST_AGENT"
            tools:ignore="ProtectedPermissions"/>
    <uses-permission
            android:name="android.permission.ACCESS_FINE_LOCATION"
            android:usesPermissionFlags="neverForLocation"
            tools:targetApi="31"/>
    <uses-permission
            android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
            android:usesPermissionFlags="neverForLocation"
            tools:ignore="BackgroundLocationPolicy"
            tools:targetApi="31"/>
    <uses-permission
            android:name="android.permission.NEARBY_WIFI_DEVICES"
            android:usesPermissionFlags="neverForLocation"
            tools:targetApi="33"/>
    <uses-permission
            android:name="android.permission.QUERY_ALL_PACKAGES"
            tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission"/>

    <!-- 应用权限 -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT"/>

    <!-- 枚举可信代理服务，用于计算设置页中“可信 WLAN”的高亮条目 -->
    <queries>
        <intent>
            <action android:name="android.service.trust.TrustAgentService"/>
        </intent>
    </queries>

    <application
            android:name=".MTweaks"
            android:allowBackup="true"
            android:description="@string/app_summary"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:theme="@style/AppTheme">

        <!-- Xposed 管理器入口，隐藏桌面图标后仍可从这里打开；singleTask 保证与桌面别名复用同一实例 -->
        <activity
                android:name=".activities.SettingsActivity"
                android:exported="true"
                android:launchMode="singleTask"
                android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS"/>
            </intent-filter>
        </activity>

        <!-- 桌面图标入口，可单独启用/禁用 -->
        <activity-alias
                android:name=".Launcher"
                android:enabled="true"
                android:exported="true"
                android:icon="@mipmap/ic_launcher"
                android:label="@string/app_name"
                android:targetActivity=".activities.SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity android:name=".activities.ShareFilterActivity"/>

        <activity
                android:name="me.dreamvoid.mtweaks.activities.WlanTrustAgentActivity"
                android:excludeFromRecents="true"
                android:exported="false"
                android:label="@string/pref_trust_agent_wifi"
                android:launchMode="singleInstance"
                android:permission="android.permission.READ_SEARCH_INDEXABLES"
                android:taskAffinity="me.dreamvoid.mtweaks.activities.WlanTrustAgentActivity"
                android:theme="@style/AppThemeModern"/>

        <service
                android:name="me.dreamvoid.mtweaks.services.WlanTrustAgent"
                android:directBootAware="true"
                android:exported="true"
                android:label="@string/pref_trust_agent_wifi"
                android:permission="android.permission.BIND_TRUST_AGENT">
            <intent-filter>
                <action android:name="android.service.trust.TrustAgentService"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>

            <meta-data
                    android:name="android.service.trust.trustagent"
                    android:resource="@xml/trust_agent_wlan"/>
        </service>

    </application>

</manifest>