<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:title="@string/pref_category_pixel_launcher">
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_pixel_launcher_clear_all_bottom"
            android:title="@string/pref_pixel_launcher_clear_all_bottom"
            android:summary="@string/pref_pixel_launcher_clear_all_bottom_summary" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_pixel_launcher_themed_icon_pack"
            android:title="@string/pref_pixel_launcher_themed_icon_pack"
            android:summary="@string/pref_pixel_launcher_themed_icon_pack_summary" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_pixel_launcher_better_app_sort"
            android:title="@string/pref_pixel_launcher_better_app_sort"
            android:summary="@string/pref_pixel_launcher_better_app_sort_summary" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_pixel_launcher_no_adaptive_icon"
            android:title="@string/pref_pixel_launcher_no_adaptive_icon"
            android:summary="@string/pref_pixel_launcher_no_adaptive_icon_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_category_google_photos">
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_google_photos_spoof_pixel_xl"
            android:title="@string/pref_google_photos_spoof_pixel_xl"
            android:summary="@string/pref_google_photos_spoof_pixel_xl_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_category_pixel_thermometer">
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_pixel_thermometer_force_bts"
            android:title="@string/pref_pixel_thermometer_force_bts"
            android:summary="@string/pref_pixel_thermometer_force_bts_summary" />
    </PreferenceCategory>
</PreferenceScreen>
