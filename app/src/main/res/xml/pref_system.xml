<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:title="@string/pref_category_system_share">
        <Preference
            android:key="@string/key_system_share_filter"
            android:title="@string/pref_system_share_filter"
            android:summary="@string/pref_system_share_filter_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_category_display">
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_display_refuse_forced_brightness"
            android:title="@string/pref_display_refuse_forced_brightness"
            android:summary="@string/pref_display_refuse_forced_brightness_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_category_trust_agent">
        <Preference
            android:key="@string/key_trust_agent_wifi_aps"
            android:title="@string/pref_trust_agent_wifi"
            android:summary="@string/pref_trust_agent_wifi_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_category_app_info">
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_app_info_open_app_data_folder"
            android:title="@string/pref_app_info_open_app_data_folder"
            android:summary="@string/pref_app_info_open_app_data_folder_summary" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_app_info_go_market"
            android:title="@string/pref_app_info_go_market"
            android:summary="@string/pref_app_info_go_market_summary" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_app_info_allow_disable"
            android:title="@string/pref_app_info_allow_disable"
            android:summary="@string/pref_app_info_allow_disable_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_category_debug">
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_debug_app_crash_info"
            android:title="@string/pref_debug_app_crash_info"
            android:summary="@string/pref_debug_app_crash_info_summary" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/key_debug_debuggable"
            android:title="@string/pref_debug_debuggable"
            android:summary="@string/pref_debug_debuggable_summary" />
    </PreferenceCategory>
</PreferenceScreen>
