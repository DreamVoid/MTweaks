    <string name="pref_category_pixel_launcher">Pixel 启动器</string>
    <string name="pref_pixel_launcher_clear_all_bottom">在最近任务界面的下方添加全部清除按钮</string>
    <string name="pref_pixel_launcher_clear_all_bottom_summary">把最左侧的"全部清除"按钮添加到其他功能按钮的旁边\n作用域：Pixel 启动器</string>
    <string name="pref_pixel_launcher_themed_icon_pack">带主题的图标包</string>
