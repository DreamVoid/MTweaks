    <string name="pref_category_display">显示</string>
    <string name="pref_display_refuse_forced_brightness">拒绝强制亮度</string>
    <string name="pref_display_refuse_forced_brightness_summary">阻止应用设定强制性的临时的屏幕亮度\n仅 Android 10+\n作用域：系统框架</string>

    <string name="pref_category_gestures">手势</string>
    <string name="pref_system_advanced_power_menu">高级电源菜单</string>
    <string name="pref_system_advanced_power_menu_summary">作用域：系统框架、系统界面</string>

    <string name="pref_category_screen_capture">屏幕捕获</string>
    <string name="pref_capture_force_screen_capture">强制启用屏幕捕获</string>
    <string name="pref_capture_force_screen_capture_summary">允许截图和录屏捕获设置了 FLAG_SECURE 的界面\n仅 Android 12+\n作用域：系统框架、系统界面</string>
    <string name="pref_capture_disable_screenshot_detection">禁用截图检测</string>
    <string name="pref_capture_disable_screenshot_detection_summary">阻止应用获知自身被截图\n仅 Android 14+\n作用域：系统框架</string>
    <string name="pref_capture_disable_screen_recording_detection">禁用录屏检测</string>
    <string name="pref_capture_disable_screen_recording_detection_summary">阻止应用获知自身被录屏\n仅 Android 15+\n作用域：系统框架</string>

    <string name="pref_category_trust_agent">信任的环境</string>
    <string name="pref_trust_agent_wifi">可信 WLAN</string>
    <string name="pref_trust_agent_wifi_summary">连接到可信的 WLAN 网络时，让设备保持解锁状态\n同时使用 SSID 和 BSSID 来确定 WLAN 是否可信\n你需要到 \"设置 -> 安全 -> 信任的代理\" 启用此代理\n请手动给予始终可用的位置权限，否则 SSID 和 BSSID 都无法获得\n作用域：系统框架、设置</string>
    <string name="pref_trust_agent_wifi_summary_settings">连接到可信的 WLAN 网络时，让设备保持解锁状态</string>

    <string name="pref_category_app_info">应用信息</string>
    <string name="pref_app_info_open_app_data_folder">打开应用数据/APK文件夹</string>
    <string name="pref_app_info_open_app_data_folder_summary">通常情况下会打开以下目录：\n- /data/data/[package_name]\n- /sdcard/Android/data/[package_name]\n- /data/user_de/0/[package_name]\n- /data/app/[package_name]\n你需要一个支持 root 的文件管理器\n以菜单的形式添加\n作用域：设置</string>
    <string name="pref_app_info_go_market">跳转到应用商店</string>
    <string name="pref_app_info_go_market_summary">在应用市场查看对应的应用\n以菜单的形式添加\n作用域：设置</string>
    <string name="pref_app_info_allow_disable">允许禁用系统核心应用</string>
    <string name="pref_app_info_allow_disable_summary">这将让\"禁用\"按钮在系统核心应用上也可被点击\n小心，你也许会让你的手机变砖\n\"禁用\"按钮会变为红色来给予警告\n作用域：设置</string>

    <string name="pref_category_debug">调试 / 其它</string>
    <string name="pref_debug_app_crash_info">在应用崩溃的时候显示调试信息</string>
    <string name="pref_debug_app_crash_info_summary">作用在崩溃时系统弹出的对话框上\n用户安装的应用内所有捕获异常的功能都将被禁掉\n作用域：系统框架</string>
    <string name="pref_debug_debuggable">设置所有应用为可调试</string>
    <string name="pref_debug_debuggable_summary">相当于在 AndroidManifest.xml 中设置 debuggable\n作用域：系统框架</string>

